# =====================================================================
# Autonomous Document Agent - Environment Configuration
# =====================================================================

# Groq API Configuration (OpenAI-compatible client)
# Obtain a free API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Agent Execution Settings
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=3

# Output Directory for Generated Word Documents
OUTPUT_DIR=outputs

# Server Settings
HOST=127.0.0.1
PORT=8000
